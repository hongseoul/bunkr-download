{
  "name": "bunkr-download",
  "version": "1.0.0",
  "description": "A media downloader for bunkr file storage with concurrent, resumable downloads, batch URL lists, filters, custom output locations, progress indication, organized directory structure, and error logging. Includes a desktop UI (Electron) for previewing albums and selecting files.",
  "type": "module",
  "main": "electron/main.js",
  "bin": {
    "bunkr-download": "src/index.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node src/index.js",
    "build:ext": "node scripts/build-extension.mjs",
    "readme-media": "electron scripts/readme-media/record.mjs",
    "test": "node --test",
    "lint": "eslint .",
    "dist": "electron-builder --win portable --x64 --publish never",
    "dist:dir": "electron-builder --win --x64 --dir --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "bunkr",
    "downloader",
    "media",
    "album",
    "cli",
    "electron"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hongseoul/bunkr-download.git"
  },
  "homepage": "https://github.com/hongseoul/bunkr-download#readme",
  "bugs": {
    "url": "https://github.com/hongseoul/bunkr-download/issues"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "https-proxy-agent": "^9.1.0",
    "p-limit": "^6.2.0",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.9.3",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.5.0",
    "globals": "^17.13.0"
  },
  "build": {
    "appId": "com.bunkrdownload.app",
    "productName": "bunkr-download",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "bunkr-download-${version}-portable.exe"
    }
  }
}
